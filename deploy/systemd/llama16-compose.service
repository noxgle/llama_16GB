[Unit]
Description=llama_16GB stack (docker compose)
Documentation=https://github.com/noxgle/llama_16GB
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
Conflicts=llama16-router.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/llama16
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
