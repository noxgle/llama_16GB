# ══════════════════════════════════════════════════════════════════
# llama_16GB — default profile (copy to .env)
# Qwen3.8-27B UD-IQ3_S + MTP, 48K context, q8_0 KV, ~15.1 GiB VRAM
# ══════════════════════════════════════════════════════════════════

# --- image (CI build; pin a stable tag, never :latest) ---
LLAMA_IMAGE=ghcr.io/noxgle/llama-server-16gb:stable-b12811-v1
LLAMA_REF=b12811
LLAMA_NATIVE=OFF
GGML_CUDA_ARCH=120a

# --- model (local files; MTP head is in a subdirectory so -hf is unusable) ---
MODEL_FLAG=-m
MODEL=/models/Qwen3.8-27B-UD-IQ3_S.gguf
ALIAS=qwen3.8-27b

# --- server ---
PORT=8089
HOST=0.0.0.0

# --- context / memory ---
CTX=49152
N_PREDICT=-1
NGLAYERS=999
LOAD_MODE=mlock
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
CACHE_RAM=4096
CACHE_REUSE=256
CTX_CHECKPOINTS=4

# --- runtime ---
FLASHATTN=on
BATCH=1024
UBATCH=512
THREADS=4
THREADS_BATCH=4
PARALLEL=1
POLL=50
THREADS_HTTP=2

# --- MTP speculative decoding ---
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=2
SPEC_DRAFT_N_MIN=0
SPEC_DRAFT_P_MIN=0.0
DRAFT_FLAG=-md
DRAFT_MODEL=/models/mtp-Qwen3.8-27B-Q4_0.gguf
GPU_LAYERS_DRAFT=99

# --- thinking ---
REASONING_EFFORT=medium
PRESERVE_THINKING=false
REASONING_BUDGET=-1

# --- vision (v2) ---
MMPROJ_FLAG=--no-mmproj
MMPROJ=
