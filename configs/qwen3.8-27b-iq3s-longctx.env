# ══════════════════════════════════════════════════════════════════
# LONG-CONTEXT PROFILE — Qwen3.8-27B UD-IQ3_S, no MTP
# 16 GB GPU, 128K context, q4_0 KV cache
# Estimated VRAM: ~14.6 GiB of 15.9 GiB usable
# For agents / RAG with large prompts. KV is cheap here: only the 16
# full-attention layers allocate cache, DeltaNet layers keep fixed state.
# ══════════════════════════════════════════════════════════════════

MODEL_FLAG=-m
MODEL=/models/Qwen3.8-27B-UD-IQ3_S.gguf
ALIAS=qwen3.8-27b

PORT=8089
HOST=0.0.0.0

CTX=131072
N_PREDICT=-1

NGLAYERS=999

FLASHATTN=on
BATCH=1024
UBATCH=512
THREADS=4
THREADS_BATCH=4
PARALLEL=1
POLL=50

LOAD_MODE=mlock

# q4_0 keeps 128K KV at ~2.25 GiB; q8_0 would be ~4.25 GiB and OOM
CACHE_TYPE_K=q4_0
CACHE_TYPE_V=q4_0

CACHE_RAM=8192
# Model cards recommend 1.0; repetition penalty fights ngram speculation
REPEAT_PENALTY=1.0
CACHE_REUSE=256
# 128K context + 4 checkpoints ~= 600 MiB RAM
CTX_CHECKPOINTS=8

SPEC_TYPE=ngram-mod
SPEC_DRAFT_N_MAX=2
SPEC_DRAFT_N_MIN=0
SPEC_DRAFT_P_MIN=0.0
DRAFT_FLAG=-md
DRAFT_MODEL=
GPU_LAYERS_DRAFT=0

REASONING_EFFORT=medium
PRESERVE_THINKING=false
REASONING_BUDGET=-1

MMPROJ_FLAG=--no-mmproj
MMPROJ=
