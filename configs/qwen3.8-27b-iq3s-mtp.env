# ══════════════════════════════════════════════════════════════════
# DEFAULT PROFILE — Qwen3.8-27B UD-IQ3_S + MTP (draft-mtp)
# 16 GB GPU (RTX 5060 Ti), 48K context, q8_0 KV cache
# Estimated VRAM: ~15.1 GiB of 15.9 GiB usable
# ══════════════════════════════════════════════════════════════════

# Model (local file — MTP head is in a subdirectory, so -hf does not work)
MODEL_FLAG=-m
MODEL=/models/Qwen3.8-27B-UD-IQ3_S.gguf
ALIAS=qwen3.8-27b

# Server
PORT=8089
HOST=0.0.0.0

# Context (48K). Raise only after measuring VRAM on the target card.
CTX=49152
N_PREDICT=-1

# GPU layers — dense model, everything on GPU
NGLAYERS=999

# Runtime
FLASHATTN=on
BATCH=1024
UBATCH=512
THREADS=4
THREADS_BATCH=4
PARALLEL=1
POLL=50

# Memory
LOAD_MODE=mlock

# KV cache (only the 16 full-attention layers allocate KV)
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# Prompt cache in system RAM (MB) — 8192 needed for Qwen3.8 hybrid state
CACHE_RAM=8192
# Model cards recommend 1.0; repetition penalty fights ngram speculation
REPEAT_PENALTY=1.0
CACHE_REUSE=256

# Context checkpoints (~150 MiB each; with MTP verify log lines first)
CTX_CHECKPOINTS=8

# MTP speculative decoding
SPEC_TYPE=draft-mtp,ngram-mod
SPEC_DRAFT_N_MAX=2
SPEC_DRAFT_N_MIN=0
SPEC_DRAFT_P_MIN=0.0
DRAFT_FLAG=-md
DRAFT_MODEL=/models/mtp-Qwen3.8-27B-Q4_0.gguf
GPU_LAYERS_DRAFT=99

# Thinking: xhigh (default) | medium | low
REASONING_EFFORT=medium
PRESERVE_THINKING=false
# Token budget for internal reasoning; -1 = unlimited
REASONING_BUDGET=-1

# Vision (v2) — disabled: empty path + --no-mmproj
MMPROJ_FLAG=--no-mmproj
MMPROJ=
