# ═══════════════════════════════════════════════════════════════════
# INKLING-2-MINI — UD-Q4_K_M, MoE with experts in host RAM
# 16 GB GPU + ~30 GB host RAM, 128K context, q8_0 KV cache
#
# Use the Mainline_Support GGUF (renamed .gguf_file -> .gguf):
# deploy/download-model.sh --model inkling2
# The root GGUF uses Unsloth's own layout and mainline llama.cpp
# rejects it ("tensor 'blk.24.attn_q.weight' not found").
# ═══════════════════════════════════════════════════════════════════

MODEL_FLAG=-m
MODEL=/models/Inkling-2-Mini-UD-Q4_K_M.gguf
ALIAS=inkling2-mini

PORT=8089
HOST=0.0.0.0

# Native window is 1M; 128K is the tested target on this hardware.
CTX=131072
N_PREDICT=-1

NGLAYERS=999
FLASHATTN=on
BATCH=1024
UBATCH=256
THREADS=4
THREADS_BATCH=4
PARALLEL=1
POLL=50

LOAD_MODE=none

# q8_0 KV: ~2x context vs F16 per Unsloth; verify VRAM headroom on this card.
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# Host RAM: ~16.6 GB pinned experts + cache + OS — do NOT raise to 8192.
CACHE_RAM=4096
CACHE_REUSE=256
CTX_CHECKPOINTS=8

# DSpark (draft-dspark) is available from b12811; no MTP head.
SPEC_TYPE=none
SPEC_DRAFT_N_MAX=2
SPEC_DRAFT_N_MIN=0
SPEC_DRAFT_P_MIN=0.0
DRAFT_FLAG=-md
DRAFT_MODEL=
GPU_LAYERS_DRAFT=0

# Model card sampling: temp 1.0 / top-p 1.0 / top-k 0 / min-p 0.
TEMPERATURE=1.0
TOP_P=1.0
TOP_K=0
MIN_P=0.0
REPEAT_PENALTY=1.0

# MoE: keep looped-layer experts on GPU, move only non-looped experts to CPU.
# A 1.5 GiB GPU cache holds the hot CPU-resident experts.
CPU_MOE_FLAG=
OT_FLAG=--override-tensor
OT_VALUE='blk\.(0|1|2|3|20|21|22|23)\.ffn_.*_exps.*=CPU'
# Host-tensor op offload stays ON (default). UBatch=256 is the sweet spot for
# prefill at 128K q8_0 KV; the MoE cache is off to free ~1.5 GiB for it.
OP_OFFLOAD_FLAG=
MOE_CACHE_FLAG=--moe-cache-mib
MOE_CACHE_MIB=0
MOE_SHARE_FLAG=--moe-cache-cpu-share
MOE_CACHE_CPU_SHARE=0.0

# Template accepts xhigh|high|medium|low|minimal|none|max or 0..0.99.
REASONING=auto
REASONING_EFFORT=low
PRESERVE_THINKING=false
REASONING_BUDGET=8192
# Shown when a thinking-budget cap is hit (requires REASONING_BUDGET >= 0).
REASONING_BUDGET_MESSAGE=" thinking budget exceeded, answer now."

# Text-only v1 (mmproj-F16.gguf exists but vision is deferred).
MMPROJ_FLAG=--no-mmproj
MMPROJ=
