# ══════════════════════════════════════════════════════════════════
# QUALITY PROFILE — Qwen3.8-27B UD-Q3_K_XL, no MTP
# 16 GB GPU, 32K context, q8_0 KV cache
# Estimated VRAM: ~14.4 GiB of 15.9 GiB usable
# Use when quality matters more than context length / speculative decoding.
# ══════════════════════════════════════════════════════════════════

MODEL_FLAG=-m
MODEL=/models/Qwen3.8-27B-UD-Q3_K_XL.gguf
ALIAS=qwen3.8-27b

PORT=8089
HOST=0.0.0.0

CTX=32768
N_PREDICT=-1

NGLAYERS=999

FLASHATTN=on
BATCH=1024
UBATCH=512
THREADS=4
THREADS_BATCH=4
PARALLEL=1
POLL=50

LOAD_MODE=mlock

CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

CACHE_RAM=4096
CACHE_REUSE=256
CTX_CHECKPOINTS=4

# No MTP in this profile: the draft head does not fit next to 13.15 GB of weights
SPEC_TYPE=none
SPEC_DRAFT_N_MAX=2
SPEC_DRAFT_N_MIN=0
SPEC_DRAFT_P_MIN=0.0
DRAFT_FLAG=-md
DRAFT_MODEL=
GPU_LAYERS_DRAFT=0

REASONING_EFFORT=medium
PRESERVE_THINKING=false
REASONING_BUDGET=-1

MMPROJ_FLAG=--no-mmproj
MMPROJ=
